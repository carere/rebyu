  "author": {
    "name": "Kevin Abatan",
    "email": "abatan.k@gmail.com"
  },
  "type": "module",
  "imports": {
    "#components/*": "./src/client/components/*.tsx",
    "#ui/*": "./src/client/components/ui/*.tsx",
    "#utils": "./src/client/lib/utils.ts",
    "#i18n/*": "./src/i18n/*.js"
  },
  "exports": {
