    "@kobalte/core": "^0.13.11",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "lucide-solid": "^0.468.0",
    "postcss": "8.5.30",
    "solid-js": "^1.9.9",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.0",
    "tsup": "^8.5.0",
    "tw-animate-css": "1.4.0",
    "vite": "^7.1.0",
