{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/check-pr-body.ts",
        "scripts/check-release.ts",
        "scripts/set-release-version.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "apps/website": {
      "entry": ["scripts/seed.ts"],
      "project": ["src/**/*.ts", "*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": ["wrangler"],
      "includeEntryExports": false
    },
    "packages/vite-plugin-rebyu": {
      "entry": [
        "src/index.ts",
        "src/client-api.ts",
        "src/client/index.tsx",
        "vite.client.config.ts",
        "scripts/compile-i18n.ts",
        "tests/**/*.test.ts",
        "tests/integration/browser/**/*.e2e.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.ts",
        "postcss/**/*.ts",
        "scripts/**/*.ts",
        "*.ts"
      ],
      // Preserve the published API and the vendored Zaidan component APIs.
      "includeEntryExports": false,
      // Knip does not discover CLI commands in project-level Moon files.
      "ignoreDependencies": ["tsup"],
      "ignore": [
        "src/client/components/ui/*.tsx",
        "src/client/components/color-mode.tsx",
        "src/client/components/blocks/filters/**"
      ]
    }
  }
}
