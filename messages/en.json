  "review_total": [
    {
      "declarations": ["input shown", "input total", "local plural = total: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{shown} of {total} comment",
        "plural=*": "{shown} of {total} comments"
      }
    }
  ],
  "review_unread_replies": [
    {
      "declarations": ["input count", "local plural = count: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{count} unread reply",
        "plural=*": "{count} unread replies"
      }
    }
  ],
  "review_unread_conversations": [
    {
      "declarations": ["input count", "local plural = count: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{count} unread reply in your conversations",
        "plural=*": "{count} unread replies in your conversations"
      }
    }
  ],
