  "review_total": [
    {
      "declarations": ["input shown", "input total", "local plural = total: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{shown} sur {total} commentaire",
        "plural=*": "{shown} sur {total} commentaires"
      }
    }
  ],
  "review_unread_replies": [
    {
      "declarations": ["input count", "local plural = count: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{count} réponse non lue",
        "plural=*": "{count} réponses non lues"
      }
    }
  ],
  "review_unread_conversations": [
    {
      "declarations": ["input count", "local plural = count: plural"],
      "selectors": ["plural"],
      "match": {
        "plural=one": "{count} réponse non lue dans vos conversations",
        "plural=*": "{count} réponses non lues dans vos conversations"
      }
    }
  ],
