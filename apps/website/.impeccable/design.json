      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:space-between;gap:36px;background:var(--ink,#292c31);color:#fff;font:500 14px Onest,sans-serif;padding:16px 20px;border-radius:7px;text-decoration:none;transition:background-color 160ms ease}.ds-primary svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0;}.ds-primary:hover{background:#3d4249}.ds-primary:focus-visible{outline:2px solid var(--focus,#627523);outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none}}"
