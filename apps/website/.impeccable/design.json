      "html": "<div class=\"ds-note-field\"><label for=\"ds-message\">Your note</label><textarea id=\"ds-message\" name=\"message\" rows=\"2\" maxlength=\"2000\" placeholder=\"What would you change?\" required></textarea></div>",
      "css": ".ds-note-field{display:grid;gap:8px;color:var(--ink,#292c31);font-family:Onest,sans-serif}.ds-note-field label{font-size:11px;font-weight:500}.ds-note-field textarea{box-sizing:border-box;width:100%;min-height:70px;resize:vertical;border:1px solid #ccd3c1;border-radius:5px;background:#fff;padding:10px 12px;font:12px/1.6 Onest,sans-serif;color:var(--ink,#292c31);caret-color:var(--focus,#627523)}.ds-note-field textarea::placeholder{color:var(--muted,#62685b)}.ds-note-field textarea:focus-visible{outline:2px solid var(--focus,#627523);outline-offset:5px;}"
