{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rebyu",
  "compatibility_date": "2026-10-18",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "route": {
    "custom_domain": true,
    "pattern": "rebyu.carere.dev"
  }
}
